# SMTP settings for the contact form (api/contact.ts).
# Set these in Vercel: Project Settings -> Environment Variables. Never commit real values.

# Gmail example: smtp.gmail.com, port 465, your Gmail address, and a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-app-password

# Inbox that receives contact messages (defaults to SMTP_USER)
CONTACT_TO_EMAIL=you@example.com
