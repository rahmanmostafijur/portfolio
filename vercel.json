{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about", "destination": "/#about", "permanent": false },
    { "source": "/experience", "destination": "/#career", "permanent": false },
    { "source": "/education", "destination": "/#education", "permanent": false },
    { "source": "/projects", "destination": "/#projects", "permanent": false },
    { "source": "/projects/:slug", "destination": "/#projects", "permanent": false },
    { "source": "/contact", "destination": "/#contact", "permanent": false },
    { "source": "/publications", "destination": "/", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
